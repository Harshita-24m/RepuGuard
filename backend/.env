# ============================================
# ReputGuard Environment Variables
# ============================================
# Copy this file as .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://harshitamishracs27_db_user:qJnOZp6RJHRD0KUx@cluster0.tsfksnx.mongodb.net/repuguard
#Username and password of mongodb harshitamishracs27_db_user, qJnOZp6RJHRD0KUx
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/repuguard

# JWT
JWT_SECRET=repuguard_super_secret_key_change_in_production_2024
JWT_EXPIRE=7d

# ============================================
# SOCIAL MEDIA API KEYS (Real Integration)
# ============================================

# Twitter/X API v2
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# YouTube Data API v3
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaSyB3KQB4KIoq8OO1C-mNEaCKkzXT5LCKejU

# Reddit API
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Claude/Anthropic AI API (for AI report generation)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# FEATURE FLAGS
# ============================================
# Set to "true" to use real APIs, "false" for mock data
USE_REAL_TWITTER=false
USE_REAL_YOUTUBE=true
USE_REAL_REDDIT=false
USE_REAL_AI=false

